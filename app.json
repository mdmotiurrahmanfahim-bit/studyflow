{
  "expo": {
    "name": "Student Academic Planner",
    "slug": "student-academic-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6D5CE8",
          "defaultChannel": "academic-reminders"
        }
      ]
    ],
    "android": {
      "package": "com.studentplanner.academic",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED"
      ]
    }
  }
}